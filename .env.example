# Copy to .env and fill in values for your app.
# Never commit .env or .env.<env> — secrets belong here only.

APP_NAME=CoFee
APP_SLUG=cofee
APP_TYPE=flutter
APP_ENV=dev
PLATFORM=android

API_BASE_URL=

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Device (single-device / sequential runs)
DEVICE_NAME=emulator-5554
AVD_NAME=cofee_avd
PLATFORM_VERSION=14
# UDID=

# App install — use APP_PATH for a local APK/IPA, or APP_PACKAGE/APP_ACTIVITY
# to target an already-installed build (Android), or BUNDLE_ID (iOS).
APP_PATH=builds/cofee-dev.apk
APP_PACKAGE=cofee.life.app.dev
APP_ACTIVITY=cofee.life.app.MainActivity
# BUNDLE_ID=

# iOS Simulator (macOS + Xcode only). See .env.ios.example
# PLATFORM=ios
# DEVICE_NAME=iPhone 16
# PLATFORM_VERSION=18.0
# APP_PATH=builds/cofee-dev.app

# Reset behaviour between test sessions
NO_RESET=true
FULL_RESET=false

# Waits
EXPLICIT_WAIT_TIMEOUT=15

# --- Credentials / test data (never real accounts) ---
# Mobile + OTP login
TEST_MOBILE=
TEST_OTP=
# Email + password login
DEFAULT_USERNAME=
DEFAULT_PASSWORD=
# Feature-scoped test data
FEATURE_ORG_ID=
FEATURE_ACCOUNT_ID=

# MCP / debugging
# NO_UI=true            # when true, MCP screenshots save to target/mcp-screenshots/ instead of opening a viewer
