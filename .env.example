# Copy to .env and fill in values for your app.
# Never commit .env — secrets belong here or in .env.<env> only.

APP_NAME=CoFee
APP_SLUG=cofee
APP_TYPE=flutter
APP_ENV=dev
PLATFORM=android

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Device (single-device / sequential runs)
DEVICE_NAME=emulator-5554
PLATFORM_VERSION=14
# UDID=

# Parallel runs (pytest -n N): one worker → one device
# Pool length must be >= N. Example for 3 workers:
# DEVICE_POOL=emulator-5554,emulator-5556,emulator-5558
# Optional: one Appium server per worker (otherwise share APPIUM_PORT + unique systemPort)
# APPIUM_PORT_POOL=4723,4725,4727
# ANDROID_SYSTEM_PORT_BASE=8200
# IOS_WDA_LOCAL_PORT_BASE=8100

# App install — use APP_PATH for APK/IPA/.app, or package/activity (Android) / bundle (iOS)
APP_PATH=builds/cofee-dev.apk
# APP_PACKAGE=cofee.life.app.dev
# APP_ACTIVITY=cofee.life.app.MainActivity
# BUNDLE_ID=

# iOS Simulator (macOS + Xcode only). See .env.ios.example
# PLATFORM=ios
# DEVICE_NAME=iPhone 16
# PLATFORM_VERSION=18.0
# APP_PATH=builds/cofee-dev.app

NO_RESET=true
FULL_RESET=false
AUTO_GRANT_PERMISSIONS=true
NEW_COMMAND_TIMEOUT=300
ANDROID_IDLE_TIMEOUT=1000

# Credentials (never commit real values)
# TEST_MOBILE=+91XXXXXXXXXX
# TEST_OTP=       # fixed dev OTP when supported
# DEFAULT_USERNAME=
# DEFAULT_PASSWORD=

# API / backend (derived from APP_REGISTRY if unset)
# API_BASE_URL=https://api.dev.cofee.life

# Optional feature-scoped setup (fallback chain for shared suites)
# FEATURE_ORG_ID=
# FEATURE_ACCOUNT_ID=

# Optional DB assertions
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

EXPLICIT_WAIT_TIMEOUT=20
POLL_FREQUENCY=0.5

# RECORD_VIDEO=false
# HEADLESS_EMULATOR=false
