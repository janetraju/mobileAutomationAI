# iOS Simulator example — copy values into .env on a Mac (Xcode required).
# Linux cannot boot the iOS Simulator.

APP_NAME=CoFee
APP_SLUG=cofee
APP_TYPE=flutter
APP_ENV=dev
PLATFORM=ios

APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Simulator name as shown in Xcode → Window → Devices and Simulators
DEVICE_NAME=iPhone 16
PLATFORM_VERSION=18.0
# UDID=   # optional: xcrun simctl list devices booted

# .app (Simulator) or .ipa (device). Bundle id is filled from APP_REGISTRY if unset.
APP_PATH=builds/cofee-dev.app
# BUNDLE_ID=cofee.life.app.dev

NO_RESET=true
FULL_RESET=false
AUTO_GRANT_PERMISSIONS=true
NEW_COMMAND_TIMEOUT=300

# Parallel simulators (macOS): unique WDA ports if sharing one Appium server
# DEVICE_POOL=iPhone 16,iPhone 15
# IOS_WDA_LOCAL_PORT_BASE=8100

# TEST_MOBILE=
# TEST_OTP=

EXPLICIT_WAIT_TIMEOUT=20
POLL_FREQUENCY=0.5
